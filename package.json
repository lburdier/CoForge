{
  "name": "coforge",
  "productName": "CoForge",
  "version": "0.5.0",
  "description": "Modélisation 3D collaborative en temps réel (blocking, hard surface, éclairage, rendu)",
  "author": "CoForge",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "build:web": "vite build",
    "build:node": "node scripts/build-node.mjs",
    "build": "npm run build:web && npm run build:node",
    "start": "electron .",
    "server": "node dist-server/coforge-server.cjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "dist": "npm run build && electron-builder --win nsis --x64 --publish never",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "fflate": "^0.8.3",
    "fzstd": "^0.1.1",
    "lib0": "^0.2.102",
    "lucide-react": "^1.72.0",
    "pyodide": "^314.0.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "three-bvh-csg": "^0.0.18",
    "three-gpu-pathtracer": "^0.0.28",
    "three-mesh-bvh": "^0.9.18",
    "ws": "^8.22.2",
    "y-protocols": "^1.0.7",
    "y-websocket": "^3.1.0",
    "yjs": "^13.6.33",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.187.0",
    "@types/ws": "^8.5.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
